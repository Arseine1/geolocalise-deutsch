# Kopieren Sie diese Datei nach „sms-proxy.env“ (gleicher Ordner) und füllen Sie sie aus. Geben Sie sms-proxy.env niemals weiter.
# Ohne Zugangsdaten läuft der Proxy im TESTMODUS: Er zeigt die SMS im Terminal an, ohne etwas zu senden.

# Vonage-Zugangsdaten: Vonage-Dashboard > Startseite (API key und API secret)
VONAGE_API_KEY=
VONAGE_API_SECRET=

# Empfänger: Nummern im internationalen Format OHNE „+“, durch Kommas getrennt
# Deutsches Beispiel: +49 151 2345 6789 wird zu 4915123456789 (Vorwahl 49, ohne die führende 0 der Nummer)
# Vonage-Testkonto: nur Ihre eigene Nummer und verifizierte Testnummern; ein Guthaben hebt diese Grenze auf
# (Die Nummern lassen sich später auch direkt in der Seite ändern; sie liegen dann in tools/sms-recipients.json.)
SMS_TO=

# Absender: alphanumerischer Name mit höchstens 11 Zeichen (in Deutschland akzeptiert) oder eine Vonage-Nummer
SMS_FROM=Geofence

# Überwachte Person, wie sie in den SMS erscheint: „ALARM: Ihr Patient hat gerade seine Kontrollzone verlassen ...“
# Beispiel mit Vornamen: PATIENT_LABEL=Ihr Patient Marie  (Umlaute werden automatisch umgeschrieben)
PATIENT_LABEL=Ihr Patient

# Schutzmaßnahmen (Standardwerte)
MIN_INTERVAL_SECONDS=30
DAILY_MAX=10

# Lauschport. Erlaubte Seiten: standardmäßig jede auf diesem Rechner geöffnete Seite; um eine genaue Liste zu erzwingen,
# entfernen Sie unten das „#“
SMS_PROXY_PORT=3001
# ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Um den Testmodus auch mit Zugangsdaten zu erzwingen: SMS_DRY_RUN=1
