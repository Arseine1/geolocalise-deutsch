# Sprachnachrichten: Konfigurationsvorlage (von „node setup.js“ nach tools/voice.env kopiert).
# Diese Datei ist von git ausgeschlossen: Sie enthält das Token des Geräts. Geben Sie sie nicht weiter.

# 1 = Sprachnachrichten aktiviert, 0 = deaktiviert
VOICE_ENABLED=1

# Token, das das Gerät im Header X-Voice-Token sendet (von „node setup.js“ erzeugt).
# In firmware/heltec_gps_geofence/secrets.h (VOICE_TOKEN) übernehmen. Bleibt es leer, wird kein echtes Gerät akzeptiert.
VOICE_DEVICE_TOKEN=

# 1 = das Relay lauscht zusätzlich im lokalen Netzwerk (zweiter Port, Token erforderlich), für ein echtes Gerät per WLAN.
# 0 = lauscht nur auf diesem Computer (empfohlen, solange es kein echtes Gerät gibt).
VOICE_LAN=0
VOICE_LAN_PORT=8081

# Aufbewahrungsdauer der Aufnahmen in Tagen (danach werden sie gelöscht)
VOICE_RETENTION_DAYS=7
